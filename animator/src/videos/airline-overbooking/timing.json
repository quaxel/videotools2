 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You booked seat fourteen C. Tonight, two people are holding that seat.",
   "from": 0,
   "to": 82
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "Across town, a guy on the same flight hits snooze again.",
   "from": 85,
   "to": 171
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "You race to the airport, check in early, and feel safe.",
   "from": 174,
   "to": 257
  },
  {
   "i": 3,
   "speaker": "agent",
   "text": "This flight is oversold. We need volunteers.",
   "from": 261,
   "to": 355
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "Nobody moves. Then the gate agent calls your name.",
   "from": 359,
   "to": 430
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "You did nothing wrong. The airline sold your seat twice, on purpose.",
   "from": 446,
   "to": 561
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "A seat is like fresh milk. After takeoff, it can never be sold.",
   "from": 564,
   "to": 671
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "And every day, some passengers just don't show up.",
   "from": 675,
   "to": 746
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Airlines track exactly how many, route by route.",
   "from": 750,
   "to": 823
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Estimates put no-shows between five and fifteen percent.",
   "from": 827,
   "to": 916
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "So on a hundred and sixty seat jet, the computer might sell sixteen extra tickets.",
   "from": 919,
   "to": 1019
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Most days, the sleepers cancel out the extras and every seat is full.",
   "from": 1022,
   "to": 1111
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Some days, everyone shows up.",
   "from": 1115,
   "to": 1160
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Then the airline buys seats back, with vouchers, from volunteers first.",
   "from": 1164,
   "to": 1270
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "If nobody bites, someone gets bumped, and the airline can owe up to four times the fare.",
   "from": 1274,
   "to": 1403
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "It's rare. In twenty sixteen, about nine in ten thousand passengers lost their seat.",
   "from": 1407,
   "to": 1522
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Tonight, it happened to you.",
   "from": 1525,
   "to": 1567
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "You take the voucher. Seat fourteen C flies without you.",
   "from": 1571,
   "to": 1660
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "And the guy who hit snooze? He just booked tomorrow's flight.",
   "from": 1664,
   "to": 1738
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "Guess which seat he got.",
   "from": 1742,
   "to": 1769
  }
 ],
