  {
   "i": 0,
   "speaker": "narrator",
   "text": "These World War Two tanks were full of air.",
   "from": 0,
   "to": 83
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "They belonged to a secret American unit called the Ghost Army.",
   "from": 91,
   "to": 173
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "In Europe, soldiers set inflatable tanks in open fields.",
   "from": 181,
   "to": 259
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "They played battle sounds and sent fake radio messages.",
   "from": 265,
   "to": 357
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "From far away, the enemy saw a huge American force.",
   "from": 364,
   "to": 431
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "About eleven hundred soldiers could pretend to be more than thirty thousand.",
   "from": 439,
   "to": 541
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "While the enemy watched the fake army, the real troops moved somewhere else.",
   "from": 548,
   "to": 634
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Sometimes, a convincing trick can save lives.",
   "from": 650,
   "to": 743
  }
 ],
