  {
   "i": 0,
   "speaker": "bart",
   "text": "Rule's simple. When the piano stops, we draw.",
   "from": 0,
   "to": 110
  },
  {
   "i": 1,
   "speaker": "bart",
   "text": "Not now.",
   "from": 399,
   "to": 418
  },
  {
   "i": 2,
   "speaker": "pruitt",
   "text": "Won't take a minute, sir.",
   "from": 431,
   "to": 471
  },
  {
   "i": 3,
   "speaker": "pruitt",
   "text": "Six foot one.",
   "from": 535,
   "to": 565
  },
  {
   "i": 4,
   "speaker": "tex",
   "text": "Six foot three.",
   "from": 583,
