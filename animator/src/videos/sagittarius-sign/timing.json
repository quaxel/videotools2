 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "Your Sagittarius friend booked a flight to Peru mid-brunch.",
   "from": 0,
   "to": 99
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "She did it mid-sentence with syrup all over her phone.",
   "from": 102,
   "to": 185
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Meet Luna who is fun and free and dangerously honest.",
   "from": 189,
   "to": 269
  },
  {
   "i": 3,
   "speaker": "luna",
   "text": "Your bangs were a mistake babe but I love you!",
   "from": 273,
   "to": 349
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "Bea touches her bangs while Luna is already ordering pancakes.",
   "from": 352,
   "to": 452
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Her suitcase is always packed and she sleeps in hiking boots.",
   "from": 455,
   "to": 545
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "She has seen thirty countries and zero dentists.",
   "from": 548,
   "to": 632
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Her friends throw her a goodbye party and everyone cries.",
   "from": 636,
   "to": 721
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Luna waves from the gate and she has never been happier.",
   "from": 725,
   "to": 812
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Then the gate agent holds out her hand.",
   "from": 815,
   "to": 882
  },
  {
   "i": 10,
   "speaker": "agent",
   "text": "Passport, please.",
   "from": 886,
   "to": 915
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Luna checks her pockets and her bag and her boots.",
   "from": 919,
   "to": 990
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Her passport is at home in the freezer next to the peas.",
   "from": 993,
   "to": 1073
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "So what's going on inside a Sagittarius?",
   "from": 1076,
   "to": 1158
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Picture a room where every door says EXIT.",
   "from": 1162,
   "to": 1220
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "There's a compass on the wall but north is missing.",
   "from": 1224,
   "to": 1298
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "A bow and arrow labelled TRUTH is aimed right at your bangs.",
   "from": 1302,
   "to": 1395
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "And a calendar marked PLANS is completely blank.",
   "from": 1399,
   "to": 1472
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Luna takes the bus home and the party is still going.",
   "from": 1475,
   "to": 1554
  },
  {
   "i": 19,
   "speaker": "maya",
   "text": "You're back? We still have cake!",
   "from": 1558,
   "to": 1604
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Everyone cheers and Luna eats half the cake.",
   "from": 1608,
   "to": 1670
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "That night she books a flight to Iceland.",
   "from": 1674,
   "to": 1737
  }
 ],
