 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "It's minute forty, and your Libra friend still can't choose.",
   "from": 0,
   "to": 85
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "That's Nina.",
   "from": 89,
   "to": 110
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Charming, fair and allergic to conflict.",
   "from": 114,
   "to": 183
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "She loves everyone's ideas equally and that's the problem.",
   "from": 187,
   "to": 274
  },
  {
   "i": 4,
   "speaker": "kate",
   "text": "Tacos or pizza Nina? Just pick one!",
   "from": 277,
   "to": 348
  },
  {
   "i": 5,
   "speaker": "nina",
   "text": "I love both! What do you love?",
   "from": 352,
   "to": 398
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "She makes a pros and cons list with three columns.",
   "from": 402,
   "to": 477
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "She polls the group chat and it's a perfect tie.",
   "from": 480,
   "to": 552
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Finally they find a place with no menu at all.",
   "from": 556,
   "to": 633
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Nina relaxes with no choices and no fights.",
   "from": 637,
   "to": 709
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "For the first time tonight she's winning.",
   "from": 712,
   "to": 760
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Then the waitress walks up with a tray.",
   "from": 764,
   "to": 813
  },
  {
   "i": 12,
   "speaker": "waitress",
   "text": "Tonight, you pick. Chicken or fish?",
   "from": 817,
   "to": 881
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "The whole table freezes.",
   "from": 884,
   "to": 920
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "So what's really going on inside a Libra?",
   "from": 923,
   "to": 990
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Picture a giant golden scale labelled DECISIONS with both sides always perfectly level.",
   "from": 994,
   "to": 1143
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Next to it a dial marked PLEASE EVERYONE is turned all the way up.",
   "from": 1147,
   "to": 1237
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "And a lucky coin with YES on both sides.",
   "from": 1241,
   "to": 1305
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Nina flips the coin and it lands on its edge.",
   "from": 1308,
   "to": 1386
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "The waitress waits and the kitchen closes.",
   "from": 1390,
   "to": 1445
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Nina goes home hungry and orders both with extra fries.",
   "from": 1448,
   "to": 1527
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "Next week is her birthday and Kate asks where she wants to go.",
   "from": 1531,
   "to": 1631
  }
 ],
