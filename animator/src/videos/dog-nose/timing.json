 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You wake up with a dog's sense of smell.",
   "from": 0,
   "to": 59
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "And WOW, this is a terrible idea.",
   "from": 68,
   "to": 150
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "You can smell your neighbor's breakfast.",
   "from": 161,
   "to": 209
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Yesterday's pizza.",
   "from": 218,
   "to": 247
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "And your socks?",
   "from": 255,
   "to": 285
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "OH NO. THEY'RE ALIVE!",
   "from": 295,
   "to": 376
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "You run outside for some fresh air.",
   "from": 388,
   "to": 440
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "BIG MISTAKE.",
   "from": 448,
   "to": 486
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "That tree? It's basically Instagram for dogs.",
   "from": 497,
   "to": 648
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Max was here. Bella was here.",
   "from": 658,
   "to": 707
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "And Rocky? He posted twelve times!",
   "from": 715,
   "to": 811
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Then suddenly, CHICKEN!",
   "from": 824,
   "to": 876
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "You follow the smell down the street.",
   "from": 886,
   "to": 931
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Past three houses.",
   "from": 937,
   "to": 969
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Around the corner.",
   "from": 976,
   "to": 1022
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "And, straight to a trash can.",
   "from": 1031,
   "to": 1100
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "There's already a dog there.",
   "from": 1111,
   "to": 1201
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "He looks at you. You look at him.",
   "from": 1211,
   "to": 1320
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "He's like,",
   "from": 1345,
   "to": 1357
  },
  {
   "i": 19,
   "speaker": "dog",
   "text": "Bro. Get in line.",
   "from": 1363,
   "to": 1430
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "And that's when you realize,",
   "from": 1443,
   "to": 1504
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "Dogs aren't weird. We've just been missing all the gossip!",
   "from": 1512,
   "to": 1625
  }
 ],
