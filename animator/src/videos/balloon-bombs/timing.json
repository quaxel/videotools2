 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "During World War Two, bombs crossed the Pacific without a pilot.",
   "from": 0,
   "to": 80
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "Japan built about nine thousand three hundred paper balloons, glued by teenage schoolgirls.",
   "from": 88,
   "to": 213
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Full of hydrogen, they rode the jet stream thirty-five thousand feet up, six thousand miles to America.",
   "from": 220,
   "to": 369
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Whenever one sank, it dropped a sandbag and climbed again.",
   "from": 376,
   "to": 455
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "About three hundred made it. Alaska, Montana, even Michigan.",
   "from": 462,
   "to": 571
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "America told newspapers to print nothing. Japan was left guessing.",
   "from": 579,
   "to": 685
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Geologists studied the sand in those bags to hunt down the launch beaches.",
   "from": 692,
   "to": 775
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Then, on May fifth, nineteen forty-five, a church picnic in an Oregon forest found one.",
   "from": 782,
   "to": 914
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Six people died, the only deaths from enemy attack on the American mainland.",
   "from": 930,
   "to": 1020
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "And some of those balloons were never found.",
   "from": 1027,
   "to": 1081
  }
 ],
