  {
   "i": 0,
   "speaker": "narrator",
   "text": "This Olympic runner took a car.",
   "from": 0,
   "to": 56
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "In the nineteen-oh-four St. Louis marathon, Fred Lorz stopped on a hot, dusty road and got a ride.",
   "from": 70,
   "to": 290
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "When the car broke down, he ran the final stretch and crossed the finish line first.",
   "from": 302,
   "to": 467
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "The crowd thought he had won.",
   "from": 479,
   "to": 524
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "But officials learned about the ride and disqualified him.",
   "from": 542,
   "to": 635
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "The real winner, Thomas Hicks, was so exhausted he could barely stand.",
   "from": 647,
   "to": 813
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "The man who crossed first wasn't the winner.",
   "from": 826,
   "to": 910
  }
 ],
