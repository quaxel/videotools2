 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "It's October first, and your horoscope just called you perfectly balanced.",
   "from": 0,
   "to": 103
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "You're a Libra. Charming, fair, the scales of the zodiac.",
   "from": 107,
   "to": 200
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "You buy the Libra mug and get the scales tattooed on your arm.",
   "from": 203,
   "to": 291
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Your neighbor, the astronomer, waves from her telescope.",
   "from": 295,
   "to": 368
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "At your birthday party, everyone agrees with you.",
   "from": 371,
   "to": 437
  },
  {
   "i": 5,
   "speaker": "friend",
   "text": "You are so Libra!",
   "from": 441,
   "to": 479
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Then the astronomer walks in, holding a star chart.",
   "from": 483,
   "to": 554
  },
  {
   "i": 7,
   "speaker": "astronomer",
   "text": "On your birthday, the sun was in Virgo.",
   "from": 570,
   "to": 638
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Your sign says the sun was in Libra. The sky says it wasn't.",
   "from": 641,
   "to": 754
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Sign dates were fixed over two thousand years ago, by watching the sky.",
   "from": 758,
   "to": 837
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "But Earth wobbles like a spinning top.",
   "from": 840,
   "to": 899
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "One full wobble takes about twenty-six thousand years.",
   "from": 902,
   "to": 973
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Every seventy-two years, the sky shifts one degree.",
   "from": 976,
   "to": 1055
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Today the sun sits in Virgo from about September sixteenth to October thirtieth.",
   "from": 1058,
   "to": 1157
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "It only reaches Libra around October thirty-first.",
   "from": 1161,
   "to": 1241
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "To the Greeks, Libra wasn't scales at all.",
   "from": 1245,
   "to": 1310
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Those stars used to be the claws of the Scorpion.",
   "from": 1314,
   "to": 1372
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "The Romans cut the claws off and made them scales.",
   "from": 1376,
   "to": 1444
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Its two brightest stars are still named Northern Claw and Southern Claw.",
   "from": 1448,
   "to": 1537
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "Your friend laughs. She's a Scorpio.",
   "from": 1540,
   "to": 1604
  },
  {
   "i": 20,
   "speaker": "astronomer",
   "text": "Actually, you're probably a Libra.",
   "from": 1608,
   "to": 1667
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "She's already buying the mug.",
   "from": 1671,
   "to": 1730
  }
 ],
