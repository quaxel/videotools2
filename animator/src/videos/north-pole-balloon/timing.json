 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "It's eighteen ninety-seven, and three men are flying a balloon to the North Pole.",
   "from": 0,
   "to": 122
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "No engine. Just silk, hydrogen and wind.",
   "from": 129,
   "to": 193
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Right after takeoff, their steering ropes fall off.",
   "from": 200,
   "to": 264
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Then fog freezes on the balloon, and it sinks onto the ice.",
   "from": 271,
   "to": 358
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "After sixty-five hours, they're stranded, far short of the pole.",
   "from": 365,
   "to": 431
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "For three months, they drag heavy sleds across the broken ice.",
   "from": 438,
   "to": 514
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Then they vanish. No bodies, no answers.",
   "from": 521,
   "to": 587
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Thirty-three years later, Norwegian seal hunters land on White Island.",
   "from": 595,
   "to": 704
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Under the snow, they find a boat, the men, and their diaries.",
   "from": 711,
   "to": 801
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "And their film still works. Ninety-three photos come back from the ice.",
   "from": 816,
   "to": 903
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "The last pictures of three men who never came home.",
   "from": 910,
   "to": 974
  }
 ],
