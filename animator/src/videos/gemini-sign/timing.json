 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You have brunch with your Gemini friend. Both of her.",
   "from": 0,
   "to": 70
  },
  {
   "i": 1,
   "speaker": "lily",
   "text": "Hiking at dawn? I'm obsessed!",
   "from": 73,
   "to": 130
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "That's Lily. Funny, curious and very fast.",
   "from": 134,
   "to": 210
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "She speaks four languages badly, all at the same time.",
   "from": 213,
   "to": 294
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "She has twelve group chats open, and she runs them all.",
   "from": 297,
   "to": 386
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Everyone says she's the best friend they ever had.",
   "from": 389,
   "to": 448
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Then Lily goes to the bathroom.",
   "from": 452,
   "to": 492
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "And a different Lily comes back.",
   "from": 496,
   "to": 530
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Same face, new jacket and totally new opinions.",
   "from": 546,
   "to": 639
  },
  {
   "i": 9,
   "speaker": "lily",
   "text": "Hiking? Who agreed to hiking? I hate nature.",
   "from": 643,
   "to": 730
  },
  {
   "i": 10,
   "speaker": "hana",
   "text": "You said obsessed! Four minutes ago!",
   "from": 734,
   "to": 798
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Grace quietly cancels her five a.m. alarm.",
   "from": 802,
   "to": 870
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "So what's going on inside a Gemini?",
   "from": 873,
   "to": 938
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Picture a car with two steering wheels.",
   "from": 941,
   "to": 998
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "One wheel says MOOD A, the other says MOOD B.",
   "from": 1002,
   "to": 1095
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Both are driving, and neither one has a map.",
   "from": 1098,
   "to": 1155
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Up front, a switchboard labelled GROUP CHATS.",
   "from": 1158,
   "to": 1232
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "Twelve cables, all plugged in, all buzzing.",
   "from": 1236,
   "to": 1315
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "And a coin marked DECISIONS spins forever on the dashboard.",
   "from": 1318,
   "to": 1394
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "Lily doesn't come hiking. She sends a voice note.",
   "from": 1398,
   "to": 1475
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "It's nine minutes long and covers six topics.",
   "from": 1479,
   "to": 1536
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "Hana is still listening at the top of the mountain.",
   "from": 1539,
   "to": 1610
  },
  {
   "i": 22,
   "speaker": "hana",
   "text": "Wait, she's coming tomorrow? Which Lily?",
   "from": 1613,
   "to": 1681
  }
 ],
