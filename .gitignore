# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# macOS
.DS_Store

# Dependencies / environments
node_modules/
.venv/
__pycache__/
*.pyc

# Caches and build output
.coreml-cache/
.cache/
.remotion/
*.log

# Editor / local settings
.idea/
.vscode/
.claude/settings.local.json

# YouTube uploader OAuth client and token
uploader/secrets/
uploader/client_secret*.json
uploader/uploader.db*

# Rendered videos and TTS model weights — too large for GitHub
output/
tts/model/

# Effects baked into a space (scripts/foley.py space), made on demand
animator/public/space/

# Pipeline outputs under build/, remade on demand (TTS takes, stills, QA frames, cue dumps, logs).
# Kept: approvals.json, check.ok, score.md and timings.jsonl, which hold state and history.
videos/*/build/*
!videos/*/build/approvals.json
!videos/*/build/check.ok
!videos/*/build/score.md
!videos/*/build/timings.jsonl

