 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "Niagara Falls once went silent.",
   "from": 0,
   "to": 49
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "One March night in eighteen forty-eight, people near the falls woke up to total silence.",
   "from": 58,
   "to": 180
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "No roar. No mist. Just bare wet rock.",
   "from": 188,
   "to": 256
  },
  {
   "i": 3,
   "speaker": "miller",
   "text": "Where did the water go?",
   "from": 263,
   "to": 309
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "Strong winds had pushed huge sheets of ice across Lake Erie.",
   "from": 317,
   "to": 396
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "The ice plugged the river like a cork in a bottle. And the water just stopped.",
   "from": 403,
   "to": 508
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "For about thirty hours, people walked across the empty riverbed. Some even rode horses!",
   "from": 524,
   "to": 674
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Others found rusty old muskets lying on the rocks.",
   "from": 681,
   "to": 751
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Then the ice broke. A giant wall of water came rushing back.",
   "from": 758,
   "to": 846
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Imagine standing right there when Niagara came roaring back to life.",
   "from": 853,
   "to": 951
  }
 ],
