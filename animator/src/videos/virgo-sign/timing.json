 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "Your Virgo friend brought a label maker to your party.",
   "from": 0,
   "to": 74
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "That's Anna and she's smart and helpful and terrifyingly organized.",
   "from": 78,
   "to": 188
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Her spice rack is alphabetical and her closet is color-coded.",
   "from": 192,
   "to": 294
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Even her to-do list has its own to-do list.",
   "from": 297,
   "to": 370
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "In ten minutes she has labelled your whole kitchen.",
   "from": 374,
   "to": 452
  },
  {
   "i": 5,
   "speaker": "mel",
   "text": "Anna, this is actually amazing!",
   "from": 456,
   "to": 533
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Anna glows because someone finally appreciates the system.",
   "from": 537,
   "to": 627
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Then she sees the picture frame on the wall.",
   "from": 630,
   "to": 682
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "It's tilted two degrees to the left.",
   "from": 698,
   "to": 744
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "She can't hear the music or the guests anymore.",
   "from": 748,
   "to": 813
  },
  {
   "i": 10,
   "speaker": "anna",
   "text": "Does nobody else see this?",
   "from": 817,
   "to": 860
  },
  {
   "i": 11,
   "speaker": "mel",
   "text": "See what? It's a party!",
   "from": 864,
   "to": 911
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "What's going on inside a Virgo?",
   "from": 915,
   "to": 958
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Picture an office with a giant red stamp marked wrong.",
   "from": 961,
   "to": 1044
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "It has never once been put down.",
   "from": 1047,
   "to": 1091
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "A ruler on the wall is labelled two degrees.",
   "from": 1095,
   "to": 1167
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "A clipboard says fix it and the list never ends.",
   "from": 1170,
   "to": 1250
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "And in a drawer a tiny note says I'm tired.",
   "from": 1254,
   "to": 1322
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Nobody ever reads that one.",
   "from": 1325,
   "to": 1367
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "Anna climbs the bookshelf to straighten the frame.",
   "from": 1371,
   "to": 1440
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "The bookshelf goes over and she lands on the couch.",
   "from": 1444,
   "to": 1526
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "The frame is now perfectly straight and Anna is happy.",
   "from": 1529,
   "to": 1610
  },
  {
   "i": 22,
   "speaker": "narrator",
   "text": "Then she spots Mel's boyfriend and reaches for the label maker.",
   "from": 1614,
   "to": 1706
  }
 ],
