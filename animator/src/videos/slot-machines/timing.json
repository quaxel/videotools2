{
 "fps": 30,
 "totalFrames": 1685,
 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "Two sevens. The third one stops one click short.",
   "from": 0,
   "to": 77
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "So close you can almost taste the jackpot.",
   "from": 80,
   "to": 169
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "You smack the machine in frustration. Unlucky? Not even close.",
   "from": 173,
   "to": 291
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "You switch machines, and it happens again.",
   "from": 294,
   "to": 343
  },
  {
   "i": 4,
   "speaker": "buddy",
   "text": "Bro, it's just warming up.",
   "from": 347,
   "to": 391
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "So you hit the ATM for another hundred.",
   "from": 395,
   "to": 451
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Two minutes later, it's gone, and your cup is almost empty.",
   "from": 454,
   "to": 543
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Then the repair guy you walked past earlier unlocks your machine, and you finally see inside.",
   "from": 546,
   "to": 686
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Each reel shows you twelve symbols, but the chip secretly picks from sixty-four hidden spots.",
   "from": 689,
   "to": 831
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "The jackpot seven gets exactly one.",
   "from": 834,
   "to": 898
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "The blanks hugging it get a whole dozen, each one landing one click short.",
   "from": 902,
   "to": 996
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "That's no glitch. Slot makers map the reels this way on purpose.",
   "from": 999,
   "to": 1103
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Jackpot odds stay tiny, while near misses get cranked way up.",
   "from": 1106,
   "to": 1202
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "So the reels stop beside the seven far more often than pure chance ever would.",
   "from": 1206,
   "to": 1314
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Your brain files it as almost winning. The machine files it as a loss.",
   "from": 1318,
   "to": 1429
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "So you pocket your last coin and walk out into the night.",
   "from": 1433,
   "to": 1504
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Your buddy stays.",
   "from": 1508,
   "to": 1540
  },
  {
   "i": 17,
   "speaker": "buddy",
   "text": "Come on, come on, come on!",
   "from": 1544,
   "to": 1580
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Two sevens. The third one stops one click short.",
   "from": 1584,
   "to": 1661
  }
 ],
