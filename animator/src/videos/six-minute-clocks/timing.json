 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You sprint onto the platform just as your train pulls away.",
   "from": 0,
   "to": 74
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "Your phone says you're late. Your oven clock swore you had time.",
   "from": 78,
   "to": 153
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "That oven clock has never been wrong.",
   "from": 156,
   "to": 201
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Each week your mornings feel calmer. You're winning.",
   "from": 204,
   "to": 267
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "Then your neighbour knocks, holding up his radio alarm clock.",
   "from": 271,
   "to": 347
  },
  {
   "i": 5,
   "speaker": "neighbour",
   "text": "Is yours slow too? Mine's six minutes behind!",
   "from": 362,
   "to": 449
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "So are millions of clocks across Europe.",
   "from": 453,
   "to": 521
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Your phone keeps its own time. These clocks don't.",
   "from": 525,
   "to": 603
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "They count the electricity coming out of the wall.",
   "from": 607,
   "to": 663
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "The current swings back and forth fifty times a second.",
   "from": 667,
   "to": 745
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "Fifty swings, one tick. That's the whole clock.",
   "from": 749,
   "to": 831
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Twenty-five countries share that one rhythm, from Spain to Turkey.",
   "from": 834,
   "to": 933
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "It stays at fifty only if power in matches power out.",
   "from": 937,
   "to": 1018
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "In early twenty eighteen, two Balkan grid operators fell into a dispute.",
   "from": 1021,
   "to": 1133
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Kosovo's grid was short of power, and Serbia's operator didn't fill the gap.",
   "from": 1137,
   "to": 1246
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "So the whole grid ran at about forty-nine point nine nine six.",
   "from": 1250,
   "to": 1358
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Each second, your oven lost a sliver.",
   "from": 1362,
   "to": 1414
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "From January to March, the slivers added up to almost six minutes.",
   "from": 1417,
   "to": 1500
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "In March, operators pushed extra energy in to run it slightly fast.",
   "from": 1504,
   "to": 1606
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "By April, the oven clocks had quietly caught up.",
   "from": 1610,
   "to": 1683
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Your neighbour is still resetting his radio.",
   "from": 1687,
   "to": 1732
  }
 ],
