 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "He just won the tournament. Now a gold box promises him exactly what he deserves.",
   "from": 0,
   "to": 105
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "It's a medieval test. Three sealed caskets: gold, silver, and plain lead.",
   "from": 108,
   "to": 215
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "This morning he knocked every rider into the mud.",
   "from": 219,
   "to": 299
  },
  {
   "i": 3,
   "speaker": "knight",
   "text": "Undefeated! Who deserves it more than me?",
   "from": 302,
   "to": 377
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "In the corner, a quiet woman waits her turn.",
   "from": 381,
   "to": 447
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "The gold lid reads: whoso chooseth me shall find that he deserveth.",
   "from": 451,
   "to": 548
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "His I-deserve-it needle slams into the red. His hand goes straight for the gold.",
   "from": 552,
   "to": 649
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "The lid lifts. Dust, and dead men's bones. A skull rolls into his lap.",
   "from": 653,
   "to": 794
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Silver promises what his nature desires. Inside, earth and worms.",
   "from": 798,
   "to": 926
  },
  {
   "i": 9,
   "speaker": "knight",
   "text": "But I earned this!",
   "from": 929,
   "to": 955
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "You see, in twenty fourteen, researcher Lisa Cavanaugh studied when people treat themselves.",
   "from": 971,
   "to": 1100
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "The best predictor wasn't their mood. It was feeling they deserved it.",
   "from": 1104,
   "to": 1186
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "His victory pumps that feeling up, and it shoves his hand to the gold.",
   "from": 1190,
   "to": 1285
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "The gold box never had to be good. It only had to tell a winner he'd earned it.",
   "from": 1289,
   "to": 1394
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "So the woman ignores the needle and opens plain lead.",
   "from": 1397,
   "to": 1492
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Inside, fine gold and precious stones.",
   "from": 1496,
   "to": 1556
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Today that gold box has a price tag, and the same three words.",
   "from": 1559,
   "to": 1643
  }
 ],
