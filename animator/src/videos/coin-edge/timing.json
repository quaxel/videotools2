{
 "fps": 30,
 "totalFrames": 1772,
 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "He's cutting silver off the King's money.",
   "from": 0,
   "to": 54
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "London. Coins are hammered by hand, so every edge is ragged.",
   "from": 57,
   "to": 152
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "So he snips a sliver off each one. Nobody notices a rough edge.",
   "from": 155,
   "to": 266
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "The clippings go in a jar. The coins go back out at full value.",
   "from": 270,
   "to": 368
  },
  {
   "i": 4,
   "speaker": "clipper",
   "text": "A little off the top, sir?",
   "from": 372,
   "to": 408
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "His jar of silver gets heavier every week.",
   "from": 412,
   "to": 477
  },
  {
   "i": 6,
   "speaker": "crier",
   "text": "Bring in your old coins! By order of the Mint!",
   "from": 480,
   "to": 543
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "It's sixteen ninety-six. In the Tower of London, the Mint strikes new coins by machine.",
   "from": 546,
   "to": 664
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Shiny, round and perfect. Now picture a clipper who tries it anyway.",
   "from": 668,
   "to": 777
  },
  {
   "i": 9,
   "speaker": "clipper",
   "text": "New coin, same old scissors.",
   "from": 781,
   "to": 833
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "He trims one, and pays the baker.",
   "from": 837,
   "to": 900
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "She runs her thumb around the edge, and stops.",
   "from": 903,
   "to": 970
  },
  {
   "i": 12,
   "speaker": "baker",
   "text": "Decus et tut? Where is the rest of it?",
   "from": 974,
   "to": 1050
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "The door bangs open. Men from the Mint. And in the Tower, Isaac Newton waits.",
   "from": 1066,
   "to": 1188
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Here's the trick. The new coins carry words around the rim.",
   "from": 1192,
   "to": 1270
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Decus et tutamen. An ornament and a safeguard.",
   "from": 1274,
   "to": 1341
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Cut one sliver, and the sentence breaks. Every thumb in London becomes a guard.",
   "from": 1345,
   "to": 1453
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "A ragged coin hides a theft. A written edge confesses it.",
   "from": 1456,
   "to": 1554
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "The Mint swapped out the old coins in just three years.",
   "from": 1557,
   "to": 1634
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "Feel the edge of a coin in your pocket. It's still standing guard.",
   "from": 1637,
   "to": 1720
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Safeguard.",
   "from": 1723,
   "to": 1748
  }
 ],
