 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You wake up with an eagle's vision.",
   "from": 0,
   "to": 51
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "And HOLY COW!",
   "from": 61,
   "to": 99
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "You can see EVERYTHING!",
   "from": 106,
   "to": 166
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "A tiny bird flying way up in the sky?",
   "from": 175,
   "to": 257
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "NO PROBLEM!",
   "from": 265,
   "to": 296
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Then you look across the street.",
   "from": 307,
   "to": 347
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Your neighbor is picking his nose.",
   "from": 356,
   "to": 470
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Wait. DID HE JUST EAT THAT?!",
   "from": 481,
   "to": 535
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "EWW! WHY CAN I SEE THIS?!",
   "from": 545,
   "to": 615
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "You quickly look away.",
   "from": 626,
   "to": 663
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "OH! Your crush is waving at you!",
   "from": 673,
   "to": 742
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "You wave back!",
   "from": 750,
   "to": 776
  },
  {
   "i": 12,
   "speaker": "emma",
   "text": "Hey, Buddy!",
   "from": 789,
   "to": 812
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Wait a second. She's waving at the DOG behind you.",
   "from": 828,
   "to": 942
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "AWESOME. JUST AWESOME.",
   "from": 953,
   "to": 1038
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "But hey! At least you've got super eyes!",
   "from": 1049,
   "to": 1121
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "You spot another bird high in the sky.",
   "from": 1130,
   "to": 1191
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "WOW! LOOK AT THAT THING!",
   "from": 1199,
   "to": 1251
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "You keep staring up. And then.",
   "from": 1261,
   "to": 1364
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "BONK!",
   "from": 1372,
   "to": 1381
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "You walk straight into a glass door!",
   "from": 1394,
   "to": 1460
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "Congratulations!",
   "from": 1469,
   "to": 1514
  },
  {
   "i": 22,
   "speaker": "narrator",
   "text": "You've got eagle eyes. AND A PIGEON BRAIN!",
   "from": 1527,
   "to": 1674
  }
 ],
