 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "Kentucky, eighteen seventy-six. Meat fell from the sky.",
   "from": 0,
   "to": 116
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "The sky was clear.",
   "from": 129,
   "to": 167
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Mrs. Crouch was making soap outside when pieces started landing around her.",
   "from": 176,
   "to": 286
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Two men later tasted some and said it was meat.",
   "from": 298,
   "to": 376
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "How did it get up there?",
   "from": 388,
   "to": 419
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "One theory says vultures threw up food while flying overhead.",
   "from": 431,
   "to": 524
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "But the eighteen seventy-six reports never mention any birds.",
   "from": 534,
   "to": 621
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "To this day, nobody can prove exactly what happened on that Kentucky farm.",
   "from": 634,
   "to": 774
  }
 ],
