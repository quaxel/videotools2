 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You just bought a brand new printer for forty-nine dollars. What a steal.",
   "from": 0,
   "to": 94
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "It prints concert tickets, homework, and a giant poster of your cat.",
   "from": 98,
   "to": 180
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Twelve days later, a little red low ink light starts blinking.",
   "from": 183,
   "to": 280
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "No problem. You drive to the store and grab two new cartridges.",
   "from": 284,
   "to": 382
  },
  {
   "i": 4,
   "speaker": "cashier",
   "text": "That'll be sixty-eight dollars, please.",
   "from": 386,
   "to": 461
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "The ink costs more than the whole printer did.",
   "from": 477,
   "to": 537
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "That cheap printer was never the product. It was the bait.",
   "from": 541,
   "to": 629
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Even the cheapest ink runs about thirteen dollars an ounce.",
   "from": 632,
   "to": 714
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Ounce for ounce, that's pricier than fine champagne.",
   "from": 718,
   "to": 802
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "And every cartridge hides a tiny chip that talks to the printer.",
   "from": 805,
   "to": 899
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "One update in twenty sixteen made printers reject cheaper cartridges overnight.",
   "from": 903,
   "to": 1008
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Then there's cleaning. Printers spray ink just to keep the heads from drying.",
   "from": 1011,
   "to": 1105
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Testers found some burned half the ink or more without printing anything.",
   "from": 1109,
   "to": 1195
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "In a few, only twenty to thirty percent ever reached the paper.",
   "from": 1199,
   "to": 1302
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "One printer boss even said it on live TV.",
   "from": 1306,
   "to": 1368
  },
  {
   "i": 15,
   "speaker": "boss",
   "text": "Every time a customer buys a printer, it's an investment for us.",
   "from": 1372,
   "to": 1476
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "So you're not really the customer. You're the investment.",
   "from": 1480,
   "to": 1556
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "Back home, the brand new cartridge is already blinking.",
   "from": 1559,
   "to": 1646
  }
 ],
