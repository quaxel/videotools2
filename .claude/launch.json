{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pipeline-panel",
      "runtimeExecutable": "animator/.venv/bin/python",
      "runtimeArgs": [
        "animator/scripts/pipeline.py",
        "web",
        "--no-browser"
      ],
      "port": 8766
    },
    {
      "name": "uploader",
      "runtimeExecutable": "animator/.venv/bin/python",
      "runtimeArgs": [
        "uploader/server.py"
      ],
      "port": 8765
    },
    {
      "name": "ideation",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=4310 npm --prefix ideation run dev"
      ],
      "port": 5173
    }
  ]
}
