 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You forgot your Cancer friend's birthday and she says it's fine.",
   "from": 0,
   "to": 85
  },
  {
   "i": 1,
   "speaker": "rose",
   "text": "It's totally fine!",
   "from": 88,
   "to": 120
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "She is smiling and it is not fine.",
   "from": 124,
   "to": 188
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Her name is Rose and she's warm and protective and a little soggy.",
   "from": 192,
   "to": 298
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "She cries at weddings and cat videos and car insurance ads.",
   "from": 301,
   "to": 407
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "She remembers your birthday and your mom's and your dog's.",
   "from": 411,
   "to": 495
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Her home is the safest place in town.",
   "from": 499,
   "to": 551
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Friends come over sad and leave with soup and a hug.",
   "from": 555,
   "to": 627
  },
  {
   "i": 8,
   "speaker": "amy",
   "text": "Rose, you're literally the best person alive!",
   "from": 631,
   "to": 705
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Rose feels so loved and so needed.",
   "from": 709,
   "to": 767
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "Then Amy opens the hallway closet.",
   "from": 771,
   "to": 824
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "An avalanche of boxes buries her to the neck.",
   "from": 839,
   "to": 909
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Every box has a date on it.",
   "from": 913,
   "to": 948
  },
  {
   "i": 13,
   "speaker": "amy",
   "text": "Is this my handwriting from ninth grade?",
   "from": 952,
   "to": 1010
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Rose dives for it and slips on her tissues.",
   "from": 1013,
   "to": 1083
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "What's going on inside a Cancer?",
   "from": 1086,
   "to": 1135
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Picture a crab shell with one tiny door that says safe people only.",
   "from": 1138,
   "to": 1235
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "Inside is a giant cabinet labelled FEELINGS.",
   "from": 1239,
   "to": 1303
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Every drawer is full and none of them close.",
   "from": 1307,
   "to": 1372
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "Next to it, a tissue box with a counter.",
   "from": 1375,
   "to": 1442
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Today it reads forty-one and it's only noon.",
   "from": 1445,
   "to": 1512
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "And the friend who forgot? Your drawer just opened.",
   "from": 1516,
   "to": 1583
  },
  {
   "i": 22,
   "speaker": "narrator",
   "text": "Rose still makes you soup and salts it with tears.",
   "from": 1587,
   "to": 1666
  }
 ],
