 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "He sold one tub of margarine and got a hundred-dollar fine.",
   "from": 0,
   "to": 99
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "Not for the taste. For the colour.",
   "from": 102,
   "to": 152
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "This is New Hampshire in the eighteen-nineties. The tub weighs ten pounds.",
   "from": 156,
   "to": 258
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "It looks just like butter, dyed with the same colouring butter gets.",
   "from": 261,
   "to": 370
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "And the state law seems friendly. Sell as much as you like.",
   "from": 374,
   "to": 459
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Just print oleomargarine on the tub, in letters half an inch tall.",
   "from": 463,
   "to": 559
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "He prints the letters. Clean, legal, easy money.",
   "from": 563,
   "to": 647
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Then a lawman walks in and reads the last line. It must be pink.",
   "from": 650,
   "to": 747
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Not a pink label. Pink margarine, all the way through.",
   "from": 762,
   "to": 851
  },
  {
   "i": 9,
   "speaker": "customer",
   "text": "Why is my butter pink?",
   "from": 855,
   "to": 897
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "Nobody would buy that. But the normal colour cost him a hundred dollars.",
   "from": 901,
   "to": 991
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "The law even allowed sixty days in jail.",
   "from": 994,
   "to": 1048
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "He took it to the Supreme Court, and in eighteen ninety-eight he won.",
   "from": 1051,
   "to": 1151
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "The judges said pink is not margarine's natural colour.",
   "from": 1155,
   "to": 1220
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Dyeing it pink would make it impossible to sell.",
   "from": 1223,
   "to": 1284
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "A permission with a rule that stops every sale is really a ban.",
   "from": 1288,
   "to": 1385
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "If pink was allowed, why not blue, red or black?",
   "from": 1388,
   "to": 1459
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "Or a law that made it stink?",
   "from": 1462,
   "to": 1508
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Two justices disagreed, but his conviction was thrown out.",
   "from": 1512,
   "to": 1597
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "So when a law says yes, but make it pink, it means no.",
   "from": 1600,
   "to": 1718
  }
 ],
