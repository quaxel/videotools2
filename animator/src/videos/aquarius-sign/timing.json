 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "Your Aquarius friend replied three days later, from a protest.",
   "from": 0,
   "to": 88
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "That's Iris, brilliant, rebellious and slightly alien.",
   "from": 92,
   "to": 181
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "She brews her own kombucha in the bathtub.",
   "from": 184,
   "to": 240
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "She wears wool socks with sandals completely on purpose.",
   "from": 244,
   "to": 325
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "She loves humanity, but humans she's not so sure about.",
   "from": 329,
   "to": 420
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Her weird little band plays to five people in a laundromat.",
   "from": 424,
   "to": 503
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Nobody understands her and Iris is thrilled.",
   "from": 507,
   "to": 568
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Then an influencer walks in and starts filming.",
   "from": 572,
   "to": 650
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "By morning, the video has a million views.",
   "from": 653,
   "to": 722
  },
  {
   "i": 9,
   "speaker": "brooke",
   "text": "Socks with sandals are so in right now!",
   "from": 725,
   "to": 784
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "Suddenly the whole city dresses like Iris.",
   "from": 787,
   "to": 860
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "Iris looks at them. Then she looks at her socks.",
   "from": 864,
   "to": 948
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "So what's going on inside an Aquarius?",
   "from": 952,
   "to": 1012
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Picture a lab with a telescope pointed away from people.",
   "from": 1016,
   "to": 1094
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "A box labelled FEELINGS is locked. The key says LATER.",
   "from": 1098,
   "to": 1183
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "And one big switch marked IF POPULAR, STOP.",
   "from": 1187,
   "to": 1260
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "That switch just flipped.",
   "from": 1264,
   "to": 1295
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "Iris throws away her sandals and quits the band.",
   "from": 1298,
   "to": 1365
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "Back home the bathtub kombucha explodes.",
   "from": 1369,
   "to": 1430
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "By Friday she's into beekeeping and medieval choir music.",
   "from": 1434,
   "to": 1511
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Her five fans follow her. So does the influencer.",
   "from": 1515,
   "to": 1588
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "You text Iris. She replies from a beehive.",
   "from": 1591,
   "to": 1653
  }
 ],
