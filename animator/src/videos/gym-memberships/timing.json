 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "It's January first. You just signed up for the gym, seventy dollars a month.",
   "from": 0,
   "to": 114
  },
  {
   "i": 1,
   "speaker": "coach",
   "text": "Best decision of your life! See you every day!",
   "from": 118,
   "to": 196
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "You go Monday, Tuesday, Wednesday. You feel unstoppable.",
   "from": 199,
   "to": 282
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Your neighbor laughs from his couch.",
   "from": 286,
   "to": 331
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "By March, your gym bag hasn't left the car.",
   "from": 335,
   "to": 393
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Then the salesman rings the little bell on his desk. Your payment just went through.",
   "from": 397,
   "to": 533
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "The gym isn't selling you workouts. It's selling you the plan to work out.",
   "from": 548,
   "to": 649
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Economists tracked thousands of gym members for three years.",
   "from": 652,
   "to": 732
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "New members expected to go about nine times a month. They actually went about four.",
   "from": 736,
   "to": 849
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "On the seventy dollar plan, that's over seventeen dollars a visit.",
   "from": 853,
   "to": 955
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "A ten-visit pass would have cost them ten dollars a visit.",
   "from": 959,
   "to": 1048
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "On average, they wasted about six hundred dollars.",
   "from": 1052,
   "to": 1164
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "And after their last workout, people kept paying for over two months before cancelling.",
   "from": 1168,
   "to": 1271
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "One budget chain averages around seven thousand members per gym.",
   "from": 1275,
   "to": 1361
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "That only works if they don't all show up at once.",
   "from": 1365,
   "to": 1439
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Your neighbor finally gets off the couch.",
   "from": 1442,
   "to": 1499
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "He signs up for the gym, seventy dollars a month.",
   "from": 1503,
   "to": 1576
  },
  {
   "i": 17,
   "speaker": "coach",
   "text": "See you every day!",
   "from": 1580,
   "to": 1620
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "The bell is already ringing.",
   "from": 1623,
   "to": 1659
  }
 ],
