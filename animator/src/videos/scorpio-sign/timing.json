 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "It's girls' night and your Scorpio friend just stopped blinking.",
   "from": 0,
   "to": 81
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "Jen just introduced her new boyfriend Tom.",
   "from": 84,
   "to": 145
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "That's Vera and she's loyal and intense and very quiet.",
   "from": 149,
   "to": 254
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "She knows your password and you never told her.",
   "from": 257,
   "to": 338
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "She found his ex online in eight minutes.",
   "from": 341,
   "to": 403
  },
  {
   "i": 5,
   "speaker": "jen",
   "text": "Stop it Vera, he's a nice guy!",
   "from": 407,
   "to": 473
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Vera nods slowly and writes something in her notebook.",
   "from": 476,
   "to": 547
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "So Jen ignores her and life is great.",
   "from": 551,
   "to": 622
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Flowers and dinners and weekend trips and matching sweaters.",
   "from": 625,
   "to": 729
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Then the doorbell rings.",
   "from": 733,
   "to": 770
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "It's his other girlfriend wearing the same sweater.",
   "from": 785,
   "to": 853
  },
  {
   "i": 11,
   "speaker": "kim",
   "text": "Hi, I think we need to talk.",
   "from": 856,
   "to": 908
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Tom tries to leave through the closet.",
   "from": 911,
   "to": 967
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Vera is already pouring three glasses of wine because she saw this coming.",
   "from": 970,
   "to": 1077
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "What's going on inside a Scorpio?",
   "from": 1081,
   "to": 1126
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Picture a dark room with a corkboard and red string.",
   "from": 1130,
   "to": 1200
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "Every photo on it is labelled suspect.",
   "from": 1204,
   "to": 1264
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "There's a filing cabinet marked evidence.",
   "from": 1268,
   "to": 1339
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "A padlock labelled secrets and the key is gone.",
   "from": 1342,
   "to": 1410
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "And a counter marked days since I forgave.",
   "from": 1413,
   "to": 1471
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "It has never once moved past zero.",
   "from": 1475,
   "to": 1525
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "Jen and Kim become best friends and Vera pins a new photo.",
   "from": 1528,
   "to": 1627
  },
  {
   "i": 22,
   "speaker": "narrator",
   "text": "It's your new coworker and Vera doesn't blink.",
   "from": 1631,
   "to": 1691
  }
 ],
