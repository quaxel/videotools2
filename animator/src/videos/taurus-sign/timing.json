 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You just stole a fry from a Taurus.",
   "from": 0,
   "to": 57
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "That was the biggest mistake of your life.",
   "from": 60,
   "to": 112
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Her name is Ella. Calm, loyal, and very comfortable.",
   "from": 115,
   "to": 210
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Her couch is velvet. Her blanket weighs more than you.",
   "from": 213,
   "to": 301
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "She's worn the same perfume for twelve years.",
   "from": 305,
   "to": 367
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Tonight is girls' night, and Ella planned it perfectly.",
   "from": 371,
   "to": 449
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Her favorite table, her favorite pasta, her favorite chair.",
   "from": 453,
   "to": 553
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Then Priya bursts through the door.",
   "from": 557,
   "to": 607
  },
  {
   "i": 8,
   "speaker": "priya",
   "text": "Change of plans, girls! New sushi place!",
   "from": 622,
   "to": 685
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Ella's fork stops in midair, and the room goes cold.",
   "from": 689,
   "to": 764
  },
  {
   "i": 10,
   "speaker": "ella",
   "text": "I already pictured the pasta. I'm not leaving.",
   "from": 768,
   "to": 841
  },
  {
   "i": 11,
   "speaker": "zoe",
   "text": "Come on, Ella, it's right around the corner!",
   "from": 844,
   "to": 894
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "Zoe tries to drag her chair, and falls right over.",
   "from": 898,
   "to": 978
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "So what's going on inside a Taurus?",
   "from": 981,
   "to": 1047
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "Picture a bank vault, sealed with a padlock marked PLANS.",
   "from": 1050,
   "to": 1138
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Inside, a dial labelled COMFORT is stuck on maximum.",
   "from": 1141,
   "to": 1231
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "The floor is bolted down, with a sign that says NOT MOVING.",
   "from": 1235,
   "to": 1325
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "And in the corner, a counter labelled GRUDGES.",
   "from": 1329,
   "to": 1411
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "It's on thirty-one, and it never goes down.",
   "from": 1415,
   "to": 1473
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "Number thirty-one is you. You took a fry.",
   "from": 1477,
   "to": 1547
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Priya goes to sushi alone. Ella orders dessert.",
   "from": 1551,
   "to": 1647
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "Then her cousin reaches for the bread basket.",
   "from": 1651,
   "to": 1712
  },
  {
   "i": 22,
   "speaker": "narrator",
   "text": "The counter clicks to thirty-two.",
   "from": 1716,
   "to": 1763
  }
 ],
