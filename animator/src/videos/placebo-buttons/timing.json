{
 "fps": 30,
 "totalFrames": 1787,
 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "You've hit the close door button six times, and the doors haven't moved.",
   "from": 0,
   "to": 82
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "You're late for a job interview on floor forty.",
   "from": 86,
   "to": 162
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "A firefighter strolls toward the lobby. You jab the button even harder.",
   "from": 166,
   "to": 273
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "The doors finally slide shut. You're sure your thumb did that.",
   "from": 277,
   "to": 362
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "Floor twelve. The doors open, and the firefighter steps in.",
   "from": 366,
   "to": 455
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "She turns a key, taps the same button, and the doors slam shut instantly.",
   "from": 458,
   "to": 568
  },
  {
   "i": 6,
   "speaker": "firefighter",
   "text": "Oh, it works. Just not for you.",
   "from": 584,
   "to": 651
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "In nineteen ninety, America passed a big disability law.",
   "from": 654,
   "to": 732
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Elevator doors must stay open long enough for wheelchairs and crutches.",
   "from": 736,
   "to": 830
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "That's at least three seconds, and your button can't cut it short.",
   "from": 834,
   "to": 919
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "So in many elevators, it's wired to basically nothing.",
   "from": 923,
   "to": 1019
  },
  {
   "i": 11,
   "speaker": "narrator",
   "text": "It only wakes up in fire mode, when firefighters need full control.",
   "from": 1023,
   "to": 1128
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "And crosswalks lie too. In two thousand four, New York checked its walk buttons.",
   "from": 1132,
   "to": 1251
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Of three thousand two hundred fifty, over two thousand five hundred did nothing.",
   "from": 1254,
   "to": 1405
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "They were leftovers from the nineteen seventies, before computers ran the lights.",
   "from": 1409,
   "to": 1530
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Ripping them out would cost a million dollars, so the city just left them.",
   "from": 1533,
   "to": 1620
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "You reach floor forty, two minutes late.",
   "from": 1624,
   "to": 1685
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "And down in the lobby, someone new is hitting that button.",
   "from": 1688,
   "to": 1763
  }
 ],
