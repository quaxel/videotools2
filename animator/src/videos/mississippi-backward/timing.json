 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "The Mississippi River once flowed backward.",
   "from": 0,
   "to": 76
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "In eighteen eleven and eighteen twelve, giant earthquakes shook New Madrid, Missouri.",
   "from": 84,
   "to": 218
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "Riverbanks cracked and crashed into the water.",
   "from": 225,
   "to": 285
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Then the land under the river pushed up, like a giant step.",
   "from": 292,
   "to": 386
  },
  {
   "i": 4,
   "speaker": "boatman",
   "text": "The river's running the wrong way!",
   "from": 393,
   "to": 441
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "For a few hours, part of the current rushed upstream. Waterfalls roared across the river.",
   "from": 450,
   "to": 573
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Boat crews fought huge waves, and whole trees fell into the river.",
   "from": 580,
   "to": 670
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "Then the water turned south again. But the land was changed forever.",
   "from": 686,
   "to": 810
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "The sunken ground even filled up into a brand new lake, Reelfoot Lake.",
   "from": 817,
   "to": 921
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "For a moment, the mighty Mississippi ran the wrong way.",
   "from": 928,
   "to": 1000
  }
 ],
