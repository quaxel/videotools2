 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "It's 3:15, and your Capricorn friend's calendar says LAUGH.",
   "from": 0,
   "to": 105
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "She laughs exactly once, then gets back to work.",
   "from": 109,
   "to": 188
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "That's Diana. Ambitious, reliable, and always working.",
   "from": 191,
   "to": 289
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "Her five-year plan has its own five-year plan.",
   "from": 292,
   "to": 355
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "She's twenty-six, and she already has a retirement fund.",
   "from": 359,
   "to": 455
  },
  {
   "i": 5,
   "speaker": "narrator",
   "text": "Her friends love her. They just never see her.",
   "from": 458,
   "to": 527
  },
  {
   "i": 6,
   "speaker": "narrator",
   "text": "Her last vacation was a work trip with a pool.",
   "from": 530,
   "to": 599
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "So they plan a surprise party in a meeting room.",
   "from": 603,
   "to": 677
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Diana walks in with her laptop, ready to present.",
   "from": 681,
   "to": 743
  },
  {
   "i": 9,
   "speaker": "rina",
   "text": "Surprise!",
   "from": 759,
   "to": 779
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "The confetti cannon hits her right in the face.",
   "from": 782,
   "to": 838
  },
  {
   "i": 11,
   "speaker": "diana",
   "text": "This was not in my calendar.",
   "from": 841,
   "to": 882
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "So what's going on inside a Capricorn?",
   "from": 886,
   "to": 955
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Picture a mountain with a ladder labelled GOALS.",
   "from": 959,
   "to": 1025
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "The ladder has no top, and she's still climbing.",
   "from": 1028,
   "to": 1100
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "At the bottom, a stamp marked APPROVED, covered in dust.",
   "from": 1103,
   "to": 1182
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "There's a dial labelled FUN, and it's set to two.",
   "from": 1186,
   "to": 1260
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "And a laptop that never, ever closes.",
   "from": 1263,
   "to": 1323
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "But here's her secret. She keeps every birthday card.",
   "from": 1327,
   "to": 1394
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "They're all in a folder labelled IMPORTANT.",
   "from": 1397,
   "to": 1458
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "Diana stays for exactly one hour.",
   "from": 1461,
   "to": 1518
  },
  {
   "i": 21,
   "speaker": "narrator",
   "text": "Then she books the next party for October.",
   "from": 1522,
   "to": 1589
  },
  {
   "i": 22,
   "speaker": "narrator",
   "text": "She sends everyone a calendar invite.",
   "from": 1593,
   "to": 1644
  }
 ],
