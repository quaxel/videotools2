 "lines": [
  {
   "i": 0,
   "speaker": "narrator",
   "text": "Your Aries friend quit her job at 7 a.m.",
   "from": 0,
   "to": 83
  },
  {
   "i": 1,
   "speaker": "narrator",
   "text": "She decided in the shower and emailed from the towel.",
   "from": 87,
   "to": 173
  },
  {
   "i": 2,
   "speaker": "narrator",
   "text": "That's Mia. First, fastest, and loudest.",
   "from": 177,
   "to": 257
  },
  {
   "i": 3,
   "speaker": "narrator",
   "text": "By noon, she signed up for a marathon.",
   "from": 260,
   "to": 315
  },
  {
   "i": 4,
   "speaker": "narrator",
   "text": "By dinner, she opened a bakery.",
   "from": 319,
   "to": 367
  },
  {
   "i": 5,
   "speaker": "jess",
   "text": "Mia, you have never baked anything!",
   "from": 371,
   "to": 458
  },
  {
   "i": 6,
   "speaker": "mia",
   "text": "Then I'll learn on opening day!",
   "from": 462,
   "to": 502
  },
  {
   "i": 7,
   "speaker": "narrator",
   "text": "And somehow, it works. The line wraps around the block.",
   "from": 506,
   "to": 592
  },
  {
   "i": 8,
   "speaker": "narrator",
   "text": "Then the oven door bursts open.",
   "from": 596,
   "to": 647
  },
  {
   "i": 9,
   "speaker": "narrator",
   "text": "Black smoke fills the shop, and the alarm starts singing.",
   "from": 663,
   "to": 741
  },
  {
   "i": 10,
   "speaker": "narrator",
   "text": "Her big sister walks in holding the manual.",
   "from": 745,
   "to": 804
  },
  {
   "i": 11,
   "speaker": "nora",
   "text": "You were supposed to preheat it, not launch it.",
   "from": 808,
   "to": 884
  },
  {
   "i": 12,
   "speaker": "narrator",
   "text": "So what's going on inside an Aries head?",
   "from": 888,
   "to": 959
  },
  {
   "i": 13,
   "speaker": "narrator",
   "text": "Picture a control room with one giant red button.",
   "from": 963,
   "to": 1028
  },
  {
   "i": 14,
   "speaker": "narrator",
   "text": "It says GO, and it's worn completely smooth.",
   "from": 1032,
   "to": 1103
  },
  {
   "i": 15,
   "speaker": "narrator",
   "text": "Next to it is a dial labelled PATIENCE.",
   "from": 1106,
   "to": 1169
  },
  {
   "i": 16,
   "speaker": "narrator",
   "text": "It's still in the plastic wrap.",
   "from": 1173,
   "to": 1207
  },
  {
   "i": 17,
   "speaker": "narrator",
   "text": "The switch marked THINK FIRST was never plugged in.",
   "from": 1210,
   "to": 1286
  },
  {
   "i": 18,
   "speaker": "narrator",
   "text": "The good news? Her anger burns out in four seconds.",
   "from": 1290,
   "to": 1379
  },
  {
   "i": 19,
   "speaker": "narrator",
   "text": "The bakery closes on Tuesday, and she's not even sad.",
   "from": 1383,
   "to": 1477
  },
  {
   "i": 20,
   "speaker": "narrator",
   "text": "On Wednesday, Mia opens a kickboxing gym.",
   "from": 1480,
   "to": 1550
  },
  {
   "i": 21,
   "speaker": "mia",
   "text": "How hard can punching be?",
   "from": 1554,
   "to": 1612
  },
  {
   "i": 22,
   "speaker": "narrator",
   "text": "Her first student is already on the floor.",
   "from": 1615,
   "to": 1668
  }
 ],
